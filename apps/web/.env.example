# ITINERA Web Client Environment Variables
VITE_API_URL=http://localhost:5000/api

# Firebase Web Config (from Firebase Console -> Project Settings -> General -> Web Apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=itinera-platform.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=itinera-platform
VITE_FIREBASE_STORAGE_BUCKET=itinera-platform.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
