# ITINERA Backend Environment Variables
PORT=5000
NODE_ENV=development

# Gemini API
GEMINI_API_KEY=

# OpenWeatherMap API
OPENWEATHER_API_KEY=

# Nugen Intelligence
NUGEN_API_KEY=
NUGEN_ALIGNMENT_PROJECT_ID=

# Firebase Admin SDK (Option 1: JSON file path, Option 2: Individual vars)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=itinera-platform
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
